# Copia este archivo como ".env" y ajusta los valores (el .env NO se publica).

# Opción 1: SQLite (por defecto, no requiere servidor)
DB_ENGINE=sqlite
DB_NAME=ecotech.db

# Opción 2: MySQL (comenta la opción 1 y descomenta esto)
# DB_ENGINE=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=ecotech
# DB_USER=ecotech_app
# DB_PASSWORD=clave_local
